# Number of active rows discovered from each provider.
MARKET_LIMIT=10

# Bun gateway configuration.
TUI_BRIDGE_PORT=3001
CORS_ORIGIN=http://localhost:3000

# Browser shell override for a hosted gateway, for example gateway.example.com.
NEXT_PUBLIC_TUI_BRIDGE_HOST=

# Optional. Without these, Kalshi stays live through 30-second REST polling.
# With them, the gateway also subscribes to Kalshi's authenticated WebSocket.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# KALSHI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Optional location for the native TUI's local SQLite watchlist.
MOBIUS_DB_PATH=.mobius/watchlist.sqlite
